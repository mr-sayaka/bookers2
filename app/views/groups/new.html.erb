<h2>Create Group</h2>

<% if @group.errors.any? %>
  <div class="alert alert-danger">
    <h4><%= @group.errors.count %>件のエラーがあります</h4>
    <ul>
      <% @group.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @group do |f| %>

  <div class="field">
    <%= f.label :name, "グループ名" %><br>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :introduction, "紹介文" %><br>
    <%= f.text_area :introduction %>
  </div>

  <div class="field">
    <%= f.label :image, "グループ画像" %><br>
    <%= f.file_field :image %>
  </div>

  <%= f.submit "Create Group", class: "btn btn-success" %>

<% end %>