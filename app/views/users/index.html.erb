<%= render 'layouts/list', user: @user %>

<section class="col-md-8 offset-md-1">
  <%= render 'layouts/search' %>
  <h2>Users</h2>

  <table class="w-100">
    <colgroup>
      <col style="width: 33.33%;">
      <col style="width: 33.33%;">
      <col style="width: 33.33%;">
    </colgroup>

    <tr class="border-top border-bottom">
      <th class="py-3">image</th>
      <th class="py-3">name</th>
      <th class="py-3"></th>
    </tr>

    <% @users.each do |user| %>
      <tr class="border-top">
        <td class="align-top p-2">
          <% if user.profile_image.attached? %>
            <%= image_tag user.profile_image, size: "80x80" %>
          <% else %>
            <%= image_tag 'no_image.jpg', size: "80x80" %>
          <% end %>
        </td>

        <td class="align-top p-2">
          <%= user.name %>
        </td>

        <td class="align-top p-2>
          フォロー数：
          <%= link_to user.followings.count, followings_user_path(user) %>
        </td>

        <td class="align-top p-2>
          フォロワー数：
          <%= link_to user.followers.count, followers_user_path(user) %>
        </td>

        <td class="align-top p-2">
          <% unless user == Current.user %>
            <% if Current.user.following?(user) %>
              <%= link_to "フォロー外す", user_relationships_path(user), data: { turbo_method: :delete } %>
            <% else %>
              <%= link_to "フォローする", user_relationships_path(user), data: { turbo_method: :post } %>
            <% end %>
          <% end %>
        </td>

        <td class="align-top p-2">
          <%= link_to "Show", user_path(user.id) %>
        </td>
      </tr>
    <% end %>
  </table>
</section>