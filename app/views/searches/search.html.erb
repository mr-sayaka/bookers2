<% if @range == "User" %>
  <h2>Users search for "<%= @word %>"</h2>
   <table class="w-100">
    <tr class="border-top border-bottom">
      <th>Image</th>
      <th>Name</th>
      <th colspan="3"></th>
    </tr>

    <% @users.each do |user| %>
      <tr class="border-top">
        <td class="p-2">
          <%= image_tag user.get_profile_image(80, 80) %>
        </td>

        <td class="p-2">
          <%= user.name %>
        </td>

        <td class="p-2">
          フォロー数：
          <%= link_to user.followings.count, followings_user_path(user) %>
        </td>

        <td class="p-2">
          フォロワー数：
          <%= link_to user.followers.count, followers_user_path(user) %>
        </td>

        <td class="p-2">
          <%= link_to "Show", user_path(user) %>
        </td>
      </tr>
    <% end %>
  </table>

<% else %>

  <h2>Books search for "<%= @word %>"</h2>

  <table class="w-100">
    <colgroup>
      <col style="width: 33.33%;">
      <col style="width: 33.33%;">
      <col style="width: 33.33%;">
    </colgroup>

    <tr class="border-top border-bottom">
      <th class="py-3"></th>
      <th class="py-3">Title</th>
      <th class="py-3">Option</th>
    </tr>

    <% @books.each do |book| %>
      <tr class="border-top">
        <td class="align-top p-2">
          <% if book.user.profile_image.attached? %>
            <%= image_tag book.user.profile_image, size: "80x80" %>
          <% else %>
            <%= image_tag 'no_image.jpg', size: "80x80" %>
          <% end %>
        </td>

        <td class="align-top p-2">
          <%= link_to book.title, book_path(book) %>
        </td>

        <td class="p-2">
          <%= book.body %>
        </td>
      </tr>
    <% end %>
  </table>
<%end%>