<%= render 'layouts/list', user: @user %>
<section class="col-md-8 offset-md-1">
  <h2>Book detail</h2>

<table class="table">
  <tr class="border-top">
    <!-- 画像 -->
    <td class="px-3 align-top">
      <%= link_to user_path(@book.user), class: "d-flex flex-column align-items-center text-decoration-none" do %>
        <% if @book.user.profile_image.attached? %>
          <%= image_tag @book.user.profile_image, size: "100x100" %>
        <% else %>
          <%= image_tag 'no_image.jpg', size: "100x100" %>
        <% end %>

        <span class="mt-2">
          <%= @book.user.name %>
        </span>
      <% end %>
    </td>

    <!-- タイトル -->
    <td class="px-3 align-top">
      <%= link_to @book.title, book_path(@book), class: "text-decoration-none" %>
    </td>

    <!-- 説明 -->
    <td class="px-3 align-top">
      <%= @book.body %>
    </td>


    <% if @book.user == Current.user %>

      <!-- 編集 -->
      <td class="px-3 align-top">
        <%= link_to "Edit",
          edit_book_path(@book.id),
          class: "btn btn-success text-white" %>
      </td>

      <!-- 削除 -->
      <td class="px-3 align-top">
        <%= link_to "Destroy",
          book_path(@book.id),
          data: {
            turbo_method: :delete,
            turbo_confirm: "本当に消しますか？"
          },
          class: "btn btn-danger text-white" %>
      </td>
      <td class="align-top p-2">
        <% if @book.favorited_by?(Current.user) %>
          <%= link_to book_favorite_path(@book), data: { turbo_method: :delete } do %>
            ♥<%= @book.favorites.count %>
        <% end %>
        <% else %>
          <%= link_to book_favorite_path(@book), data: { turbo_method: "post" } do %>
            ♡<%= @book.favorites.count %>
          <% end %>
        <% end %>
      </td>
                
      <td class="align-top p-2">
        <p>コメント数：<%= @book.book_comments.count %></p>
      </td>
    <% end %>

  </tr>
</table>

<div>
  <% @book.book_comments.each do |book_comment| %>
    <div class="d-flex align-items-center mb-3">

      <%= link_to user_path(book_comment.user),
            class: "d-flex flex-column align-items-center text-decoration-none" do %>
        <%= image_tag book_comment.user.get_profile_image(100,100) %>
        <span><%= book_comment.user.name %></span>
      <% end %>

      <p class="mb-0 ms-3"><%= book_comment.comment %></p>

      <% if book_comment.user == Current.user %>
        <%= link_to "Destroy",
              book_book_comment_path(book_comment.book, book_comment),
              data: { turbo_method: :delete },
              class: "btn btn-danger text-white ms-3" %>
      <% end %>

    </div>
  <% end %>
</div>

<div>
  <%= form_with model: [@book, @book_comment] do |f| %>
    <%= f.text_area :comment, rows: '5', placeholder: "コメントをここに" %>
    <%= f.submit "送信する" %>
  <% end %>
</div>
</section>