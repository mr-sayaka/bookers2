<% if @book.errors.any? %>
  <h3>
    <%= @book.errors.count %> errors prohibited this obj from being saved:
  </h3>
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= render 'layouts/list', user: @user %>
<section class="col-md-8 offset-md-1">
  <h2>Books</h2>

  <table class="w-100">
    <colgroup>
      <col style="width: 15%;">
      <col style="width: 30%;">
      <col style="width: 55%;">
    </colgroup>

    <tr class="border-top border-bottom">
      <th class="py-3"></th>
      <th class="py-3">Title</th>
      <th class="py-3">Opinion</th>
      <th class="py-3"></th>
    </tr>

    <% @books.each do |book| %>
      <tr class="border-top">
        <td class="align-top p-2">
          <%= link_to user_path(book.user) do %>
            <% if book.user.profile_image.attached? %>
              <%= image_tag book.user.profile_image, size: "80x80" %>
            <% else %>
              <%= image_tag 'no_image.jpg', size: "80x80" %>
            <% end %>
          <% end %>
        </td>

        <td class="align-top p-2">
          <%= link_to book.title, book_path(book), class: "text-decoration-none"  %>
        </td>
          
        <td class="align-top p-2">
          <%= book.body %>
        </td>

        <td class="align-top p-2">
          <% if book.favorited_by?(Current.user) %>
            <%= link_to book_favorite_path(book), data: { turbo_method: :delete } do %>
              ♥<%= book.favorites.count %>
            <% end %>
          <% else %>
            <%= link_to book_favorite_path(book), data: { turbo_method: "post" } do %>
              ♡<%= book.favorites.count %>
            <% end %>
          <% end %>
        </td>

        <td class="align-top p-2">
          <p>コメント数：<%= book.book_comments.count %></p>
        </td>
      </tr>
      <% end %>
    </tr>
  </table>
</section>