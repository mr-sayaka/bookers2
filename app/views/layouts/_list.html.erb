<section class="col-md-3">
  <h2>User info</h2>
  <% if user.profile_image.attached? %>
    <%= image_tag user.profile_image, size: "120x120" %>
  <% else %>
    <%= image_tag 'no_image.jpg', size: "120x120" %>
  <% end %>

  <table>
    <tr class="border-top border-bottom">
      <th class="py-3">name</th>
      <th class="py-3"><%= user.name %></th>
    </tr>
    <tr class="border-top border-bottom">
      <th class="py-3">introduction</th>
      <th class="py-3"><%= user.introduction %></th>
    </tr>
    <tr class="border-top border-bottom">
     <th class="py-3">follows</th>
     <td class="py-3"><%= link_to user.followings.count, followings_user_path(user) %></td>
   </tr>
   
   <tr class="border-top border-bottom">
      <th class="py-3">followers</th>
      <td class="py-3"><%= link_to user.followers.count, followers_user_path(user) %></td>
    </tr>
  </table>

  <% if user == Current.user %>
    <%= link_to edit_user_path(user), class: "btn btn-outline-secondary w-50" do %>
      <i class="fas fa-user-cog"></i>
    <% end %>
  <% else %>
    <% if Current.user.following?(user) %>
      <%= link_to "フォロー外す", user_relationships_path(user), data: { turbo_method: :delete }, class: "btn btn-secondary w-50" %>
    <% else %>
      <%= link_to "フォローする", user_relationships_path(user), data: { turbo_method: :post }, class: "btn btn-primary w-50" %>
    <% end %>
  <% end %>

  <h2 class="py-3">New book</h2>
  <%= form_with model: Book.new do |f| %>
    <div class="mb-3">
      <%= f.label :title, class: "d-block" %>
      <%= f.text_field :title %>
    </div>

    <div class="mb-3">
      <%= f.label :body, class: "d-block" %>
      <%= f.text_area :body %>
    </div>
  
    <div>
      <%= f.submit 'Create Book', class: 'btn btn-success text-white' %>
    </div>
  <% end %>
</section>